{
  "name": "readlatercleaner",
  "private": false,
  "version": "0.1.0",
  "description": "Privacy-friendly Manifest V3 extension for cleaning and reviewing read-later backlogs.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
